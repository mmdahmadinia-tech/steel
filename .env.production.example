# ============================================
# STEELMETRICS - Liara Deployment Configuration
# ============================================
# این فایل نمونه برای استقرار روی Liara است
# مقادیر را با تنظیمات واقعی Liara جایگزین کنید

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=production

# --------------------------------------------
# Database Configuration (Liara PostgreSQL)
# --------------------------------------------
# Liara PostgreSQL connection details
# These will be provided by Liara after creating PostgreSQL service
DB_HOST=your-liara-postgres-host.liara.run
DB_PORT=30412
DB_NAME=steelmetrics
DB_USER=your-liara-db-user
DB_PASSWORD=your-liara-db-password

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-generate-with-openssl
JWT_EXPIRES_IN=24h

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ORIGIN=https://steelmetrics.ir

# --------------------------------------------
# API Configuration
# --------------------------------------------
API_URL=https://api.steelmetrics.ir
VITE_API_URL=https://api.steelmetrics.ir

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=80

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info
