# ============================================
# STEELMETRICS Environment Configuration
# ============================================
# این فایل را کپی کنید و مقادیر را تنظیم کنید:
# cp .env.example .env

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=production

# --------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------
# ⚠️ IMPORTANT: Change these in production!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steelmetrics
DB_USER=steelmetrics_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# ⚠️ IMPORTANT: Generate a strong secret!
# You can use: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=24h

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Frontend URL (for CORS)
CORS_ORIGIN=https://steelmetrics.ir

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Backend API URL (for frontend)
API_URL=https://steelmetrics.ir/api

# Frontend API URL (for Vite)
VITE_API_URL=https://steelmetrics.ir/api

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=5000

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info

# --------------------------------------------
# Security
# --------------------------------------------
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Liara Deployment (Optional)
# --------------------------------------------
# If deploying on Liara, you can use their environment variables
# LIARA_API_TOKEN=your-liara-token
