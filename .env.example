# ============================================
# STEELMETRICS - Environment Configuration
# ============================================
# این فایل را با نام .env کپی و مقادیر را تنظیم کنید

# --- سرور ---
VITE_APP_NAME=STEELMETRICS
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://steelmetrics.ir

# --- API Backend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# --- احراز هویت ---
VITE_AUTH_TOKEN_KEY=steelmetrics_token
VITE_SESSION_TIMEOUT=3600000

# --- پایگاه داده (Backend) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=steelmetrics
# DB_USER=steelmetrics_user
# DB_PASSWORD=your_secure_password

# --- امنیت ---
# JWT_SECRET=your_jwt_secret_key_here
# BCRYPT_ROUNDS=12

# --- پشتیبان‌گیری ---
# BACKUP_DIR=/var/backups/steelmetrics
# BACKUP_SCHEDULE=0 6 * * *
# BACKUP_RETENTION_DAYS=30

# --- لاگ ---
# LOG_LEVEL=info
# LOG_DIR=/var/log/steelmetrics
